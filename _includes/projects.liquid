{% assign project_url = project.url | relative_url %}
{% if project.redirect %}
  {% assign project_url = project.redirect %}
{% endif %}
<div class="col">
  <div class="card h-100 hoverable">
    {% if project.img %}
      <a href="{{ project_url }}" tabindex="-1" aria-hidden="true">
        {% include figure.liquid loading="lazy" path=project.img sizes="(min-width: 768px) 450px, 95vw" alt=project.title class="card-img-top" %}
      </a>
    {% endif %}
    <div class="card-body d-flex flex-column">
      <h3 class="card-title">
        <a href="{{ project_url }}">{{ project.title }}</a>
      </h3>
      {% if project.status %}
        <p class="project-status">{{ project.status }}</p>
      {% endif %}
      <p class="card-text">{{ project.description }}</p>
      <div class="mt-auto">
        <a href="{{ project_url }}" class="btn btn-sm z-depth-0" aria-label="Read about {{ project.title }}">Project</a>
        {% if project.github %}
          <a href="{{ project.github }}" class="btn btn-sm z-depth-0" aria-label="Code for {{ project.title }}">Code</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
